APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=petcare_shop_dev
DB_USER=petcare_app
DB_PASSWORD=replace-with-a-local-password
# Optional in development; required in production. Path to the MySQL provider's
# CA bundle inside the app container. Production verifies both certificate and hostname.
DB_SSL_CA=
# Per process; Compose defaults can open up to 20 across web, email and export workers.
DB_POOL_SIZE=5
# Active image decodes per web process (1–4). Compose runs 2 Gunicorn workers,
# so the default allows at most 2 concurrent image operations per web container.
IMAGE_PROCESSING_CONCURRENCY=1
# Production schema migration only. Inject these into a one-off migration job,
# never into the long-running web container. In local development the initializer
# falls back to DB_USER/DB_PASSWORD when these are blank.
# MIGRATION_DB_HOST=
# MIGRATION_DB_PORT=
# MIGRATION_DB_NAME=petcare_shop_prod
# MIGRATION_DB_USER=petcare_migrator
# MIGRATION_DB_PASSWORD=
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=replace-with-a-long-local-root-password

# Optional OpenAI-compatible model endpoint. Leave blank for the local assistant.
# When enabled, chat sends aggregated shop data to this endpoint; image analysis is separately opt-in.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=15
AI_VISION_ENABLED=0
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
ASSISTANT_IP_RATE_LIMIT_PER_MINUTE=120
VISION_RATE_LIMIT_PER_MINUTE=8
VISION_IP_RATE_LIMIT_PER_MINUTE=40
# Shared MySQL limits for stored pet/product photo uploads, per admin account/network.
CATALOG_IMAGE_UPLOAD_RATE_LIMIT_PER_MINUTE=12
CATALOG_IMAGE_UPLOAD_IP_RATE_LIMIT_PER_MINUTE=60
TENANT_EXPORT_RATE_LIMIT_PER_MINUTE=2
# Generate a stable key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production must use one shared secret-store key for web and export-worker.
TENANT_EXPORT_JOB_KEY=
# During key rotation, add old keys comma-separated until pending jobs finish.
TENANT_EXPORT_JOB_FALLBACK_KEYS=
TENANT_EXPORT_STORAGE_BACKEND=local
TENANT_EXPORT_RETENTION_HOURS=24
AI_ALLOW_HTTP_ENDPOINT=0

# Optional private S3-compatible object storage for multi-instance deployments.
# Leave backend=local for development. Production S3 should use HTTPS and the
# cloud workload's IAM role where available; never enable public bucket access.
MEDIA_STORAGE_BACKEND=local
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_ADDRESSING_STYLE=auto
MEDIA_S3_PREFIX=petcare
MEDIA_S3_SERVER_SIDE_ENCRYPTION=AES256

# Local web server port. Change it if another macOS service already uses 5000.
APP_PORT=5000
PUBLIC_BASE_URL=http://127.0.0.1:5000
PUBLIC_SIGNUP_ENABLED=0
PUBLIC_SIGNUP_EMAIL_RATE_LIMIT_PER_MINUTE=3
PUBLIC_SIGNUP_IP_RATE_LIMIT_PER_MINUTE=5

# Account email verification and password recovery. Production requires SMTP
# STARTTLS. Keep credentials in the deployment secret store.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=PetCare Manager
MAIL_STARTTLS=1
MAIL_TIMEOUT_SECONDS=10
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable in the deployment secret store; it encrypts pending email payloads.
MAIL_OUTBOX_KEY=
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=3
PASSWORD_RESET_IP_RATE_LIMIT_PER_MINUTE=15
EMAIL_VERIFICATION_RATE_LIMIT_PER_MINUTE=3
EMAIL_VERIFICATION_IP_RATE_LIMIT_PER_MINUTE=10
TENANT_INVITATION_RATE_LIMIT_PER_MINUTE=10
TENANT_OWNER_TRANSFER_RATE_LIMIT_PER_MINUTE=5

# Optional phone access: set to 1 and replace with the laptop's private Wi-Fi URL.
# Example: LAN_ACCESS_BASE_URL=http://192.168.1.25:5001
# Both settings are required; otherwise run.py binds to localhost only.
LAN_ACCESS_ENABLED=0
LAN_ACCESS_BASE_URL=

# Set to 1 only when the app is reachable solely through one trusted reverse proxy.
TRUST_PROXY=0
OPS_METRICS_TOKEN=
